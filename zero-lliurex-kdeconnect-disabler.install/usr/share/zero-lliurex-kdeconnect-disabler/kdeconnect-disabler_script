#!/bin/bash


ACTION="$1"
PACKAGE_LIST="lliurex-kdeconnect-disabler"

case $ACTION in


	remove)

		for ix in $PACKAGE_LIST	
		do

			apt-get remove -y $ix
			TEST=$( dpkg-query -s  $ix 2> /dev/null| grep Status | cut -d " " -f 4 )
			if [ "$TEST" == 'installed' ];then
				exit 1
			fi
		done
		apt-get install kdeconnect || true		
				
	;;	
esac
exit 0
